<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:em="using:CompanyTimesheet.Desktop"
        x:Class="CompanyTimesheet.Desktop.LoginWindow"
        x:DataType="em:EmployeeViewModel"
        Title="{em:Tr 'Evidencija radnog vremena - Prijava'}"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource AppSurface}">

    <Grid Margin="32">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Border Background="{DynamicResource AppAccentFill}" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="AccountClock" Foreground="White" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="{em:Tr 'Evidencija radnog vremena'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" HorizontalAlignment="Center"/>
                    <TextBlock Name="EmpLoginSubtitle" Text="{em:Tr 'Prijavite se na svoj račun'}" FontSize="13" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"
                               IsVisible="{Binding !MustChangePassword}"/>
                </StackPanel>
            </StackPanel>

            <!-- A saved sign-in is being tried -->
            <StackPanel Name="EmpRestoring" IsVisible="{Binding IsRestoring}" Spacing="10" Margin="0,24">
                <ProgressBar IsIndeterminate="True" Width="160"/>
                <TextBlock Text="{em:Tr 'Provjera prijave…'}" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextMuted}"/>
            </StackPanel>

            <!-- Sign-in form -->
            <StackPanel IsVisible="{Binding ShowSignInForm}" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{em:Tr 'Korisničko ime'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AppText}"/>
                    <TextBox Name="EmpLoginUser" Text="{Binding LoginUsername}" Watermark="{em:Tr 'Upišite korisničko ime'}" Padding="12,10" FontSize="13"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{em:Tr 'Lozinka'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AppText}"/>
                    <TextBox Name="EmpLoginPassword" Text="{Binding LoginPassword}" PasswordChar="●" Watermark="{em:Tr 'Upišite lozinku'}" Padding="12,10" FontSize="13"/>
                </StackPanel>
                <CheckBox Name="EmpLoginRemember" IsChecked="{Binding LoginRemember}" Content="{em:Tr 'Zapamti me na ovom računaru'}" FontSize="13" Foreground="{DynamicResource AppText}"/>
            </StackPanel>

            <!-- The administrator chose the first password: the person chooses their own -->
            <StackPanel IsVisible="{Binding MustChangePassword}" Spacing="12">
                <TextBlock Text="{em:Tr 'Izaberite svoju lozinku'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}" HorizontalAlignment="Center"/>
                <TextBlock Text="{em:Tr 'Administrator je postavio vašu prvu lozinku. Izaberite novu, od najmanje 10 znakova.'}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AppTextMuted}"/>
                <TextBox Name="EmpNewPassword" Text="{Binding NewPassword}" PasswordChar="●" Watermark="{em:Tr 'Nova lozinka'}" Padding="12,10" FontSize="13"/>
                <TextBox Name="EmpNewPasswordAgain" Text="{Binding NewPasswordAgain}" PasswordChar="●" Watermark="{em:Tr 'Ponovite novu lozinku'}" Padding="12,10" FontSize="13"/>
            </StackPanel>

            <!-- Messages -->
            <Border IsVisible="{Binding LoginError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="#FFB42318" CornerRadius="6" Padding="10,6">
                <TextBlock Name="EmpLoginError" Text="{Binding LoginError}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
            </Border>
            <Border IsVisible="{Binding HasError}" Background="#FFB42318" CornerRadius="6" Padding="10,6">
                <TextBlock Name="EmpLoginServerError" Text="{Binding ErrorText}" FontSize="13" Foreground="White" TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons: one is the default, so Enter does what the form is for -->
            <Button Name="EmpLoginButton" IsVisible="{Binding ShowSignInForm}" Command="{Binding SignInCommand}" IsEnabled="{Binding !IsBusy}" IsDefault="{Binding ShowSignInForm}"
                    Classes="primary" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="Login" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Prijavi se'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpChangePasswordButton" IsVisible="{Binding MustChangePassword}" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding !IsBusy}" IsDefault="{Binding MustChangePassword}"
                    Classes="primary" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="KeyChange" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Sačuvaj lozinku'}"/>
                </StackPanel>
            </Button>

            <!-- Server: where the company's server is (set by IT; open only for a test) -->
            <StackPanel IsVisible="{Binding ShowSignInForm}" Spacing="6">
                <Button Name="EmpServerToggle" Command="{Binding ToggleServerFieldCommand}" Classes="secondary" Padding="8,4" FontSize="12" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ServerNetwork" Width="14" Height="14"/>
                        <TextBlock Text="{em:Tr 'Server'}"/>
                    </StackPanel>
                </Button>
                <TextBox Name="EmpServerAddress" Text="{Binding ServerAddress}" IsVisible="{Binding ShowServerField}" Watermark="{em:Tr 'https://server.firma.ba'}" Padding="12,10" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
