<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:em="using:CompanyTimesheet.Desktop"
             x:Class="CompanyTimesheet.Desktop.SideBar"
             x:DataType="em:EmployeeViewModel">

    <UserControl.Styles>
        <!-- The icon of the theme button: the moon while the look is light, the sun while it is dark. A click turns one into the other. -->
        <Style Selector="Grid.theme-icons > materialIcons|MaterialIcon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.30"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.theme-icons > materialIcons|MaterialIcon.moon">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)"/>
        </Style>
        <Style Selector="Grid.theme-icons > materialIcons|MaterialIcon.sun">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="rotate(-90deg) scale(0.5)"/>
        </Style>
        <Style Selector="Grid.theme-icons.dark > materialIcons|MaterialIcon.moon">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="rotate(90deg) scale(0.5)"/>
        </Style>
        <Style Selector="Grid.theme-icons.dark > materialIcons|MaterialIcon.sun">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)"/>
        </Style>
    </UserControl.Styles>

    <!-- The side bar of both windows: it folds to icons. It holds the look of the program, the check for a new version and the sign-out. -->
    <Border Width="{Binding SidebarWidth}" Background="{DynamicResource AppSidebar}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="8,12">

            <Button Name="SidebarToggleButton" Grid.Row="0" Classes="sidebar-nav" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{em:Tr 'Proširi ili skupi izbornik'}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <materialIcons:MaterialIcon Kind="Menu" Width="20" Height="20"/>
                    <TextBlock Text="{em:Tr 'Evidencija'}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                </StackPanel>
            </Button>

            <!-- The sections of the administration (only the administrator has them) -->
            <ScrollViewer Grid.Row="1" Margin="0,16,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsAdmin}">
            <StackPanel Spacing="4">
                <!-- An administrator who also approves: two kinds of work -->
                <Button Name="SidebarNavAdministration" Classes="sidebar-nav" Classes.active="{Binding ShowAdminSections}" IsVisible="{Binding CanSwitchWork}" Command="{Binding OpenAdminWorkCommand}" ToolTip.Tip="{em:Tr 'Administracija'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Administracija'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavTeamSheets" Classes="sidebar-nav" Classes.active="{Binding AdminShowsTeam}" IsVisible="{Binding CanSwitchWork}" Command="{Binding OpenTeamWorkCommand}" ToolTip.Tip="{em:Tr 'Šihtarice tima'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="AccountGroup" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Šihtarice tima'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavOverview" IsVisible="{Binding ShowAdminSections}" Classes="sidebar-nav" Classes.active="{Binding Admin.IsOverview}" Command="{Binding OpenAdminSectionCommand}" CommandParameter="overview" ToolTip.Tip="{em:Tr 'Pregled'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Pregled'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavPeople" IsVisible="{Binding ShowAdminSections}" Classes="sidebar-nav" Classes.active="{Binding Admin.ShowPeople}" Command="{Binding OpenAdminSectionCommand}" CommandParameter="people" ToolTip.Tip="{em:Tr 'Osobe'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="AccountMultipleOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Osobe'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavCodes" IsVisible="{Binding ShowAdminSections}" Classes="sidebar-nav" Classes.active="{Binding Admin.ShowCodes}" Command="{Binding OpenAdminSectionCommand}" CommandParameter="codes" ToolTip.Tip="{em:Tr 'Šifre'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Šifre'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavHolidays" IsVisible="{Binding ShowAdminSections}" Classes="sidebar-nav" Classes.active="{Binding Admin.ShowHolidays}" Command="{Binding OpenAdminSectionCommand}" CommandParameter="holidays" ToolTip.Tip="{em:Tr 'Praznici'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="CalendarMonthOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Praznici'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="SidebarNavAudit" IsVisible="{Binding ShowAdminSections}" Classes="sidebar-nav" Classes.active="{Binding Admin.ShowAudit}" Command="{Binding OpenAdminSectionCommand}" CommandParameter="audit" ToolTip.Tip="{em:Tr 'Revizija'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="ShieldCheckOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Revizija'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="4">

                <!-- Light or dark: the button offers the other one -->
                <Button Name="SidebarThemeToggle" Classes="sidebar-nav" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleText}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid Classes="theme-icons" Classes.dark="{Binding IsModeDark}" Width="20" Height="20">
                            <materialIcons:MaterialIcon Classes="moon" Kind="WeatherNight" Width="20" Height="20"/>
                            <materialIcons:MaterialIcon Classes="sun" Kind="WeatherSunny" Width="20" Height="20"/>
                        </Grid>
                        <TextBlock Text="{Binding ThemeToggleText}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>

                <!-- The colour palettes live in a pop-up, so a longer list of palettes never crowds the side bar -->
                <Button Name="SidebarPaletteButton" Classes="sidebar-nav" ToolTip.Tip="{em:Tr 'Boje aplikacije'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="20" Height="20" Padding="1">
                            <Ellipse Fill="{Binding CurrentPaletteSwatch}"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentPaletteLabel}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedBottom">
                            <StackPanel Name="SidebarPaletteMenu" Width="230" Spacing="2">
                                <TextBlock Text="{em:Tr 'Paleta boja'}" Classes="label" Margin="12,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding PaletteOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="em:PaletteOption">
                                            <Button Classes="sidebar-nav" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Ellipse Width="16" Height="16" Fill="{Binding Swatch}" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="18" Height="18" IsVisible="{Binding IsSelected}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{DynamicResource AppDivider}" Margin="0,6"/>
                                <Button Name="SidebarSystemTheme" Classes="sidebar-nav" Command="{Binding ToggleSystemThemeCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{em:Tr 'Prati temu Windowsa'}" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="18" Height="18" IsVisible="{Binding IsModeSystem}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- The language of the interface -->
                <Button Name="SidebarLanguageButton" Classes="sidebar-nav" ToolTip.Tip="{em:Tr 'Jezik'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="Translate" Width="20" Height="20"/>
                        <TextBlock Text="{Binding CurrentLanguageName}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedBottom">
                            <StackPanel Name="SidebarLanguageMenu" Width="200" Spacing="2">
                                <TextBlock Text="{em:Tr 'Jezik'}" Classes="label" Margin="12,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding LanguageOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="em:LanguageOption">
                                            <Button Classes="sidebar-nav" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="18" Height="18" IsVisible="{Binding IsSelected}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Name="EmpUpdateButton" Classes="sidebar-nav" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{em:Tr 'Provjeri ažuriranja'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Provjeri ažuriranja'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>
                <Button Name="EmpLogoutButton" Classes="sidebar-nav" Command="{Binding LogoutCommand}" ToolTip.Tip="{em:Tr 'Odjava'}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="Logout" Width="20" Height="20"/>
                        <TextBlock Text="{em:Tr 'Odjava'}" VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}"/>
                    </StackPanel>
                </Button>

                <!-- Who is signed in -->
                <Border Name="SidebarUserCard" Margin="0,8,0,0" Padding="8,10" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="{Binding WhoText}">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AppAccentSoft}">
                            <TextBlock Text="{Binding UserInitials}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding SidebarShowsText}" MaxWidth="150">
                            <TextBlock Name="SidebarUserName" Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="SidebarUserCode" Text="{Binding UserCode}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
