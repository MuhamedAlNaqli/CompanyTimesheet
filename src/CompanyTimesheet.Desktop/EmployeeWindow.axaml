<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:em="using:CompanyTimesheet.Desktop"
        x:Class="CompanyTimesheet.Desktop.EmployeeWindow"
        x:DataType="em:EmployeeViewModel"
        Title="{em:Tr 'Evidencija radnog vremena'}"
        Width="1280" Height="760" MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="Auto,*">
    <em:SideBar Grid.Column="0"/>
    <Grid Grid.Column="1" Margin="24,20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">

        <!-- Header: who, month -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{em:Tr 'Moja evidencija radnog vremena'}" Classes="header" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="{DynamicResource AppBadgeBg}" CornerRadius="5" Padding="8,2" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Name="EmpStatusText" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource AppBadgeText}"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock Name="EmpReviewTitle" Grid.Column="1" Text="{Binding ReviewTitle}" IsVisible="{Binding IsReviewing}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource AppTextStrong}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding ShowMonthNav}">
                <Button Name="EmpPreviousMonthButton" Command="{Binding PreviousMonthCommand}" Classes="secondary" Padding="10,8" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{em:Tr 'Prethodni mjesec'}">
                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"/>
                </Button>
                <TextBlock Name="EmpMonthTitle" Text="{Binding MonthTitle}" FontSize="18" FontWeight="SemiBold" MinWidth="170"
                           TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextStrong}"/>
                <Button Name="EmpNextMonthButton" Command="{Binding NextMonthCommand}" Classes="secondary" Padding="10,8" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{em:Tr 'Sljedeći mjesec'}">
                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18"/>
                </Button>
                <Button Name="EmpThisMonthButton" Command="{Binding ThisMonthCommand}" Classes="secondary" Padding="12,8" IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="CalendarToday" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Ovaj mjesec'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>

        <!-- Own timesheet or timesheets waiting for approval -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConnected}">
            <Button Name="EmpHomeTab" Command="{Binding ShowHomeCommand}" IsVisible="{Binding !IsAdmin}" Classes.secondary="{Binding !InHome}" Classes.primary="{Binding InHome}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Početna'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpMineTab" Command="{Binding ShowMineCommand}" Classes.secondary="{Binding !InSheet}" Classes.primary="{Binding InSheet}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="AccountClock" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Moja šihtarica'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpHistoryTab" Command="{Binding ShowHistoryCommand}" Classes.secondary="{Binding !InHistory}" Classes.primary="{Binding InHistory}" Padding="16,8"
                    ToolTip.Tip="{em:Tr 'Poslane verzije i ko je šta radio s vašom šihtaricom'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="History" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Historija'}"/>
                </StackPanel>
            </Button>
            <!-- Only for somebody who decides on timesheets: has people below them, is a designated approver or a deputy -->
            <Button Name="EmpApprovalsTab" Command="{Binding ShowApprovalsCommand}" IsVisible="{Binding IsApprover}" Classes.secondary="{Binding !InApprovals}" Classes.primary="{Binding InApprovals}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="AccountGroup" Width="18" Height="18"/>
                    <TextBlock Name="EmpApprovalsTabText" Text="{Binding PendingApprovals.TabText}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpTeamTab" Command="{Binding ShowTeamCommand}" IsVisible="{Binding IsApprover}" Classes.secondary="{Binding !InTeam}" Classes.primary="{Binding InTeam}" Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="FileTree" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Moj tim'}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Reminders, confirmation and error banners -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Border IsVisible="{Binding Reminders.HasAny}" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <ItemsControl Name="EmpRemindersList" ItemsSource="{Binding Reminders.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="em:ReminderRow">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <materialIcons:MaterialIcon Kind="BellOutline" Width="16" Height="16" Foreground="#92400E" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#92400E"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#92400E"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border IsVisible="{Binding IsViewingRevision}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="EmpRevisionBanner" Text="{Binding RevisionBanner}" TextWrapping="Wrap" Foreground="#1E40AF" VerticalAlignment="Center"/>
                    <Button Name="EmpCloseRevisionButton" Grid.Column="1" Command="{Binding CloseRevisionCommand}" Classes="secondary" Padding="12,6" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ArrowULeftTop" Width="16" Height="16"/>
                            <TextBlock Text="{em:Tr 'Nazad na trenutno stanje'}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border IsVisible="{Binding HasInfo}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <TextBlock Name="EmpInfoText" Text="{Binding InfoText}" TextWrapping="Wrap" Foreground="#166534"/>
            </Border>
            <Border IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="EmpErrorText" Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="#991B1B" VerticalAlignment="Center"/>
                    <Button Name="EmpRetryButton" Grid.Column="1" Command="{Binding LoadCommand}" Classes="secondary" Padding="12,6" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                            <TextBlock Text="{em:Tr 'Pokušaj ponovo'}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Toolbar of an opened timesheet of somebody else -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowReviewToolbar}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Name="EmpApproveButton" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanAct}" Classes="primary" Padding="14,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="CheckCircle" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Odobri'}"/>
                    </StackPanel>
                </Button>
                <Button Name="EmpReturnButton" Command="{Binding ReturnCommand}" IsEnabled="{Binding CanAct}" Classes="secondary" Padding="14,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="UndoVariant" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Vrati na ispravku…'}"/>
                    </StackPanel>
                </Button>
                <DropDownButton Name="EmpReviewPrintButton" Classes="secondary" Padding="14,9" IsVisible="{Binding CanExport}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                            <TextBlock Text="{em:Tr 'Ispis'}"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{em:Tr 'Excel'}" Command="{Binding PrintCommand}" CommandParameter="xlsx">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{em:Tr 'PDF'}" Command="{Binding PrintCommand}" CommandParameter="pdf">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Button Name="EmpCloseReviewButton" Grid.Column="1" Command="{Binding CloseReviewCommand}" Classes="secondary" Padding="14,9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Zatvori'}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toolbar of the team -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowTeamToolbar}">
            <Button Name="EmpRemindAllButton" Command="{Binding RemindAllCommand}" IsEnabled="{Binding Team.HasPeopleToRemind}" Classes="primary" Padding="14,9"
                    ToolTip.Tip="{em:Tr 'Svima koji nisu predali šihtaricu šalje obavijest na računar'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="BellRing" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Podsjeti sve koji nisu predali'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpSummaryButton" Command="{Binding ShowSummaryCommand}" Classes="secondary" Padding="14,9" IsVisible="{Binding Team.ShowTree}"
                    ToolTip.Tip="{em:Tr 'Poruka za odobravatelja: ko je radio prekovremeno, ko je bio odsutan'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Pregled za odobravanje'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpCopySummaryButton" Command="{Binding CopySummaryCommand}" Classes="primary" Padding="14,9" IsVisible="{Binding Team.ShowSummary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Kopiraj'}"/>
                </StackPanel>
            </Button>
            <Button Name="EmpTreeButton" Command="{Binding ShowTreeCommand}" Classes="secondary" Padding="14,9" IsVisible="{Binding Team.ShowSummary}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="FileTree" Width="18" Height="18"/>
                    <TextBlock Text="{em:Tr 'Nazad na stablo'}"/>
                </StackPanel>
            </Button>
            <DropDownButton Name="EmpTeamPrintButton" Classes="secondary" Padding="14,9" IsVisible="{Binding CanExport}">
                <DropDownButton.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Ispis'}"/>
                    </StackPanel>
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="{em:Tr 'Pregled za odobravanje (Excel)'}" Command="{Binding PrintSummaryCommand}" CommandParameter="xlsx">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{em:Tr 'Pregled za odobravanje (PDF)'}" Command="{Binding PrintSummaryCommand}" CommandParameter="pdf">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{em:Tr 'Šihtarice tima (Excel)'}" Command="{Binding PrintTeamCommand}" CommandParameter="xlsx">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{em:Tr 'Šihtarice tima (PDF)'}" Command="{Binding PrintTeamCommand}" CommandParameter="pdf">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Name="EmpTeamRefreshButton" Command="{Binding ShowTeamCommand}" Classes="secondary" Padding="10,9" ToolTip.Tip="{em:Tr 'Osvježi'}">
                <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>
        </StackPanel>

        <!-- Toolbar of the own month -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" IsVisible="{Binding ShowMineToolbar}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                <Button Name="EmpAddButton" Command="{Binding AddEntryCommand}" IsEnabled="{Binding IsEditable}" Classes="primary" Padding="14,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Novi unos'}"/>
                    </StackPanel>
                </Button>
                <Button Name="EmpSubmitButton" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Classes="primary" Padding="14,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Send" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Predaj na odobravanje'}"/>
                    </StackPanel>
                </Button>
                <Button Name="EmpApproveOwnButton" Command="{Binding ApproveCommand}" IsVisible="{Binding CanApproveOwn}" Classes="primary" Padding="14,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="CheckCircle" Width="18" Height="18"/>
                        <TextBlock Text="{em:Tr 'Odobri'}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{em:Tr 'Šihtarica je zaključana i ne može se mijenjati.'}" IsVisible="{Binding !IsEditable}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextMuted}"/>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <DropDownButton Name="EmpPrintButton" Classes="secondary" Padding="14,9" IsVisible="{Binding CanExport}">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                            <TextBlock Text="{em:Tr 'Ispis'}"/>
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{em:Tr 'Moja šihtarica (Excel)'}" Command="{Binding PrintCommand}" CommandParameter="xlsx">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{em:Tr 'Moja šihtarica (PDF)'}" Command="{Binding PrintCommand}" CommandParameter="pdf">
                                <MenuItem.Icon><materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Name="EmpRefreshButton" Command="{Binding LoadCommand}" Classes="secondary" Padding="10,9" ToolTip.Tip="{em:Tr 'Osvježi'}">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18"/>
                </Button>
                <Button Name="EmpListViewButton" Command="{Binding ShowListViewCommand}" Classes.primary="{Binding IsListView}" Classes.secondary="{Binding IsCalendarView}"
                        Padding="10,9" ToolTip.Tip="{em:Tr 'Prikaži kao listu'}">
                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="18" Height="18"/>
                </Button>
                <Button Name="EmpCalendarViewButton" Command="{Binding ShowCalendarViewCommand}" Classes.primary="{Binding IsCalendarView}" Classes.secondary="{Binding IsListView}"
                        Padding="10,9" ToolTip.Tip="{em:Tr 'Prikaži kao kalendar'}">
                    <materialIcons:MaterialIcon Kind="CalendarMonth" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="4" ColumnDefinitions="*,16,340" IsVisible="{Binding IsConnected}">

            <!-- The team as a tree -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding InTeam}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="20,16,20,8" Spacing="2">
                        <TextBlock Text="{em:Tr 'Moj tim'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                        <TextBlock Name="EmpTeamSummary" Text="{Binding Team.SummaryText}" IsVisible="{Binding Team.ShowTree}" Foreground="{DynamicResource AppTextMuted}"/>
                    </StackPanel>
                    <TextBlock Name="EmpTeamEmpty" Grid.Row="1" IsVisible="{Binding Team.IsEmpty}" Text="{em:Tr 'Niko se ne javlja vama.'}" Margin="20" Foreground="{DynamicResource AppTextMuted}"/>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding Team.ShowSummary}" Margin="20,0,20,16">
                        <TextBlock Name="EmpSummaryNote" Text="{Binding Team.SummaryNote}" IsVisible="{Binding Team.HasSummaryNote}" TextWrapping="Wrap"
                                   Foreground="#B45309" Margin="0,0,0,8"/>
                        <TextBox Name="EmpSummaryText" Grid.Row="1" Text="{Binding Team.SummaryBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas,Menlo,monospace" FontSize="13"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding Team.ShowTree}">
                        <ItemsControl Name="EmpTeamList" ItemsSource="{Binding Team.Rows}" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="em:TeamRow">
                                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{Binding Indent}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <materialIcons:MaterialIcon Kind="SubdirectoryArrowRight" Width="16" Height="16" IsVisible="{Binding IsBelow}" Foreground="{DynamicResource AppTextMuted}"/>
                                                <materialIcons:MaterialIcon Kind="AccountOutline" Width="20" Height="20" Foreground="{DynamicResource AppTextStrong}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                                <TextBlock Text="{Binding ReminderText}" IsVisible="{Binding HasReminder}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                            <Button Grid.Column="3" Classes="secondary" Padding="10,5" FontSize="12" IsVisible="{Binding CanRemind}"
                                                    Command="{Binding $parent[Window].DataContext.RemindCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="{em:Tr 'Šalje obavijest na računar ove osobe'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="BellRing" Width="14" Height="14"/>
                                                    <TextBlock Text="{em:Tr 'Podsjeti'}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Start screen: this month and the year in a few figures -->
            <ScrollViewer Grid.ColumnSpan="3" IsVisible="{Binding ShowHomeBody}">
                <ItemsControl Name="EmpHomeCards" ItemsSource="{Binding HomeCards}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="em:StatCard">
                            <Border Classes="stat" Classes.warn="{Binding IsWarning}" Width="290" MinHeight="118" Margin="0,0,14,14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMuted}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Caption}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMuted}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The history of the own month: the versions that were submitted and who did what -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding ShowHistoryBody}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer>
                    <StackPanel Margin="24,18" Spacing="10">
                        <TextBlock Text="{Binding MonthTitle, StringFormat='Historija šihtarice: {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                        <TextBlock Text="{em:Tr 'Ko je šta radio s vašom šihtaricom za izabrani mjesec: predaje, vraćanja na ispravku i odluke. Mjesec mijenjate strelicama gore.'}"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock Name="EmpHistoryStatus" Text="{Binding Sheet.WorkflowText}" IsVisible="{Binding Sheet.HasWorkflow}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>

                        <TextBlock Text="{em:Tr 'Predate verzije'}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock Text="{em:Tr 'Ovaj mjesec još nije predat.'}" IsVisible="{Binding !Sheet.HasRevisions}" Foreground="{DynamicResource AppTextMuted}"/>
                        <ItemsControl Name="EmpHistoryRevisions" ItemsSource="{Binding Sheet.Revisions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="em:RevisionRow">
                                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid ColumnDefinitions="140,*,Auto">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextStrong}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}"/>
                                            <Button Grid.Column="2" Classes="icon" Width="32" Height="32" ToolTip.Tip="{em:Tr 'Prikaži tu verziju'}"
                                                    Command="{Binding $parent[Window].DataContext.OpenRevisionCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{em:Tr 'Događaji'}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock Text="{em:Tr 'Nema događaja.'}" IsVisible="{Binding !Sheet.HasHistory}" Foreground="{DynamicResource AppTextMuted}"/>
                        <ItemsControl Name="EmpHistoryEvents" ItemsSource="{Binding Sheet.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="em:HistoryRow">
                                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The month: a list or a calendar -->
            <Border IsVisible="{Binding ShowDaysBody}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <TextBlock Name="EmpApprovalsHint" IsVisible="{Binding ShowApprovalsHint}" Text="{em:Tr 'Izaberite šihtaricu iz liste desno da je pregledate.'}" Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextMuted}"/>

                    <!-- List, with the heading of each column -->
                    <!-- A window too narrow for the columns gets a horizontal scroll bar instead of letting the actions run out of the card -->
                    <ScrollViewer IsVisible="{Binding ShowListPane}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="560" RowDefinitions="Auto,*">
                    <Border Margin="6,6,6,0" Padding="0,6" BorderBrush="{DynamicResource AppBorderStrong}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="5,80,130,*,48,90">
                            <TextBlock Grid.Column="1" Text="{em:Tr 'Datum'}" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            <TextBlock Grid.Column="2" Text="{em:Tr 'Vrsta dana'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            <TextBlock Grid.Column="3" Text="{em:Tr 'Unosi'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            <TextBlock Grid.Column="5" Text="{em:Tr 'Radnje'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Right" Margin="0,0,8,0"
                                       IsVisible="{Binding IsEditable}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl Name="EmpDaysList" ItemsSource="{Binding Sheet.Days}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="em:EmployeeDayRow">
                                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,2">
                                        <Grid ColumnDefinitions="5,80,130,*,48,90" MinHeight="40">
                                            <Border Background="{Binding Stripe}" CornerRadius="2" Margin="0,4"/>
                                            <StackPanel Grid.Column="1" Margin="10,4,0,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                                <TextBlock Text="{Binding WeekdayText}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TypeText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppTextMuted}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EntriesText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4"
                                                       Foreground="{DynamicResource AppTextStrong}"/>
                                            <StackPanel Grid.Column="4" IsVisible="{Binding HasIssues}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                        Background="Transparent" ToolTip.Tip="{Binding IssueTooltip}">
                                                <materialIcons:MaterialIcon Kind="AlertOutline" Width="16" Height="16" Foreground="#B45309"/>
                                                <TextBlock Text="{Binding IssueCount}" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        IsVisible="{Binding $parent[Window].DataContext.IsEditable}">
                                                <Button Classes="icon" Width="32" Height="32" ToolTip.Tip="{em:Tr 'Uredi dan'}"
                                                        Command="{Binding $parent[Window].DataContext.EditDayCommand}" CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                </Button>
                                                <Button Classes="icon" Width="32" Height="32" IsVisible="{Binding HasEntries}" ToolTip.Tip="{em:Tr 'Obriši unos'}"
                                                        Command="{Binding $parent[Window].DataContext.ClearDayCommand}" CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="{DynamicResource AppDanger}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                    </ScrollViewer>

                    <!-- Calendar: a week to a row, Monday first; a click on a day opens it -->
                    <ScrollViewer IsVisible="{Binding ShowCalendarPane}">
                        <StackPanel Margin="10" Spacing="6">
                            <ItemsControl ItemsSource="{Binding Sheet.WeekdayHeaders}" IsVisible="{Binding Sheet.HasDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTextMuted}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Name="EmpCalendar" ItemsSource="{Binding Sheet.CalendarCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:CalendarCell">
                                        <Grid MinHeight="98" Margin="2">
                                            <Button IsVisible="{Binding HasDay}" Background="Transparent" BorderThickness="0" Padding="0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Command="{Binding $parent[Window].DataContext.EditDayCommand}" CommandParameter="{Binding Row}"
                                                    ToolTip.Tip="{Binding Row.IssueTooltip}">
                                                <Border Classes="cal-cell" Classes.weekend="{Binding Row.IsWeekendCell}" Classes.holiday="{Binding Row.IsHolidayCell}" Classes.today="{Binding Row.IsTodayCell}"
                                                        CornerRadius="8" Padding="8,6">
                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Row.DayNumber}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                                            <Border Grid.Column="1" IsVisible="{Binding Row.HasIssues}" MinWidth="20" Height="18" CornerRadius="9" Background="{DynamicResource AppBadgeBg}">
                                                                <TextBlock Text="{Binding Row.IssueCount}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource AppBadgeText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Margin="0,4,0,0" Spacing="2">
                                                            <TextBlock Text="{Binding Row.CalendarEntriesText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                                                            <TextBlock Text="{Binding Row.CalendarOvertimeText}" FontSize="11" Foreground="#B45309"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2" Text="{Binding Row.HolidayText}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="#C2410C"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Pending approvals, workflow, summary, overtime, findings -->
            <ScrollViewer Grid.Column="2" IsVisible="{Binding ShowDaysBody}">
                <StackPanel Spacing="14">
                    <Border IsVisible="{Binding InApprovals}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{em:Tr 'Čeka vaše odobrenje'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpNoPendingText" Text="{em:Tr 'Nema šihtarica koje čekaju vaše odobrenje.'}" IsVisible="{Binding PendingApprovals.IsEmpty}" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpPendingList" ItemsSource="{Binding PendingApprovals.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:PendingRow">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                                            <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" FontSize="12" Foreground="#B45309"/>
                                            <Button Classes="secondary" Padding="10,5" FontSize="12" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                    Command="{Binding $parent[Window].DataContext.OpenPendingCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="14" Height="14"/>
                                                    <TextBlock Text="{em:Tr 'Otvori'}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding ShowDeputies}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{em:Tr 'Zamjena dok ste odsutni'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Text="{em:Tr 'Zamjena odlučuje o šihtaricama koje čekaju vas, u periodu koji izaberete. U historiji piše ko je odlučio i za koga.'}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpDeputiesMine" ItemsSource="{Binding Deputies.Mine}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:DeputyRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                                <TextBlock Text="{Binding Period}" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="icon" Width="32" Height="32" ToolTip.Tip="{em:Tr 'Ukloni zamjenu'}"
                                                    Command="{Binding $parent[Window].DataContext.RemoveDeputyCommand}" CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="{DynamicResource AppDanger}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Name="EmpDeputiesForOthers" ItemsSource="{Binding Deputies.ForOthers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:DeputyRow">
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                            <TextBlock Text="{Binding Period}" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox Name="EmpDeputyPerson" ItemsSource="{Binding Deputies.Candidates}" SelectedItem="{Binding Deputies.SelectedCandidate}" HorizontalAlignment="Stretch" PlaceholderText="Izaberite zamjenu"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CalendarDatePicker Name="EmpDeputyFrom" SelectedDate="{Binding Deputies.From}"/>
                                <CalendarDatePicker Name="EmpDeputyTo" SelectedDate="{Binding Deputies.To}"/>
                            </StackPanel>
                            <Button Name="EmpAddDeputyButton" Command="{Binding AddDeputyCommand}" Classes="secondary" Padding="10,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="AccountSwitch" Width="16" Height="16"/>
                                    <TextBlock Text="{em:Tr 'Postavi zamjenu'}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding Sheet.HasWorkflow}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{em:Tr 'Status šihtarice'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpWorkflowText" Text="{Binding Sheet.WorkflowText}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpChainText" Text="{Binding Sheet.ChainText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpMessagesList" ItemsSource="{Binding Sheet.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:MessageRow">
                                        <Border Background="{DynamicResource AppSurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,4">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                                                <TextBlock Text="{Binding AnswerText}" IsVisible="{Binding HasAnswer}" TextWrapping="Wrap" FontSize="12" Foreground="#15803D"/>
                                                <TextBlock IsVisible="{Binding CanAnswer}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMuted}"
                                                           Text="{em:Tr 'Odgovor upisujete pri ponovnoj predaji šihtarice.'}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="8" IsVisible="{Binding IsReviewing}">
                            <!-- Versions and history of somebody else's sheet are here; those of the own sheet are in the "Historija" tab -->
                            <TextBlock Text="{em:Tr 'Predate verzije'}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding Sheet.HasRevisions}" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpRevisionsList" ItemsSource="{Binding Sheet.Revisions}" IsVisible="{Binding Sheet.HasRevisions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:RevisionRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource AppTextStrong}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="secondary" Padding="8,4" FontSize="12" ToolTip.Tip="{em:Tr 'Prikaži tu verziju'}"
                                                    Command="{Binding $parent[Window].DataContext.OpenRevisionCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="History" Width="14" Height="14"/>
                                                    <TextBlock Text="{em:Tr 'Otvori'}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{em:Tr 'Historija'}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpHistoryList" ItemsSource="{Binding Sheet.History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:HistoryRow">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding !ShowApprovalsHint}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{em:Tr 'Zbir mjeseca'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpFundText" Text="{Binding Sheet.FundText}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpOvertimeText" Text="{Binding Sheet.OvertimeText}" Foreground="#B45309"/>
                            <ItemsControl ItemsSource="{Binding Sheet.TotalLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource AppTextMuted}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{em:Tr 'Praznici u mjesecu'}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" IsVisible="{Binding Sheet.HasHolidays}"
                                       Foreground="{DynamicResource AppTextStrong}"/>
                            <ItemsControl ItemsSource="{Binding Sheet.HolidayLines}" IsVisible="{Binding Sheet.HasHolidays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMuted}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{em:Tr 'Odsustva se ne računaju kao sati; jedan dan odsustva je 8 sati fonda.'}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding !ShowApprovalsHint}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{em:Tr 'Prekovremeni rad'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Text="{em:Tr 'Nema unosa.'}" IsVisible="{Binding Sheet.NoOvertime}" Foreground="{DynamicResource AppTextMuted}"/>
                            <ItemsControl Name="EmpCarriedList" ItemsSource="{Binding Sheet.Carried}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#B45309" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Name="EmpOvertimeList" ItemsSource="{Binding Sheet.Overtime}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:EmployeeOvertimeRow">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#B45309"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextMuted}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" IsVisible="{Binding $parent[Window].DataContext.IsEditable}">
                                                <Button Classes="icon" Width="32" Height="32" ToolTip.Tip="{em:Tr 'Uredi prekovremeni rad'}"
                                                        Command="{Binding $parent[Window].DataContext.EditOvertimeCommand}" CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                </Button>
                                                <Button Classes="icon" Width="32" Height="32" ToolTip.Tip="{em:Tr 'Obriši prekovremeni rad'}"
                                                        Command="{Binding $parent[Window].DataContext.DeleteOvertimeCommand}" CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="{DynamicResource AppDanger}"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding !ShowApprovalsHint}" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{em:Tr 'Provjera unosa'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                            <TextBlock Name="EmpNoIssuesText" Text="{em:Tr 'Nema primjedbi.'}" IsVisible="{Binding Sheet.NoIssues}" Foreground="#15803D"/>
                            <ItemsControl Name="EmpIssuesList" ItemsSource="{Binding Sheet.Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="em:EmployeeIssueRow">
                                        <StackPanel Margin="0,4" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppTextStrong}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Grid>
</Window>
